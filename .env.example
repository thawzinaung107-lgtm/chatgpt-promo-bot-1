# Required
BOT_TOKEN=replace_with_botfather_token
LLM_API_KEY=replace_with_openai_compatible_api_key

# OpenAI-compatible base URL. Use the provider's API root, usually ending in /v1.
# The bot also accepts a full /chat/completions URL and normalizes it.
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=gpt-5-mini
# Replace LLM_MODEL with your provider's exact model ID when using another service.

# Local aliases are also accepted: OPENAI_API_KEY, OPENAI_API_BASE, OPENAI_MODEL.
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL take precedence when both are present.

# Compatibility controls. Keep auto unless your provider documents otherwise.
LLM_RESPONSE_FORMAT=auto
LLM_MAX_TOKENS_PARAM=auto
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Optional for GPT-5 models: minimal, low, medium, or high.
LLM_REASONING_EFFORT=


# Comma-separated Telegram numeric user IDs allowed to use /forward and /targets.
ADMIN_IDS=123456789

# JSON object or array. The bot forwards only to these targets after relevance review.
# Escape this as one line when adding it to a hosting dashboard.
TARGETS_JSON=[{"chat_id":-1001234567890,"label":"AI Myanmar","description":"မြန်မာဘာသာ AI tools နှင့် productivity ဆိုင်ရာ content များ","allowed_categories":["AI","productivity"]}]

# Optional input limit for model prompts.
MAX_INPUT_CHARS=8000

# Optional comma-separated chat IDs where /groupscan is allowed.
# Leave blank to allow GroupScan in any chat.
GROUPSCAN_ALLOWED_CHAT_IDS=
GROUPSCAN_MAX_GROUPS=50
GROUPSCAN_MAX_FILE_BYTES=1000000
LOG_LEVEL=INFO
